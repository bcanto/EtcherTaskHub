# ══════════════════════════════════════════════════════════════════════════════
# Etcher Task Hub — ISO dev/verification project (plan §15.3)
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env.dev and fill in the values from a NEW, disposable Supabase
# project created just for this (suggested name: etcher-taskhub-dev) — NEVER the
# real project. NEVER commit .env.dev — it's already in .gitignore (`.env.*`).
#
# Used with:  node serve.mjs --envfile .env.dev            (local manual testing)
#             node .agents/iso-db-verify.cjs                (automated verification —
#             refuses to run if SUPABASE_URL contains the real project's id)
# ══════════════════════════════════════════════════════════════════════════════

# Found in: Supabase Dashboard → (your new project) → Project Settings → API
SUPABASE_URL=https://your-dev-project-ref.supabase.co
SUPABASE_ANON_KEY=your-dev-project-anon-key-here

# Full database access, bypasses RLS. Server-side only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-dev-project-service-role-key-here
