{
  "templateId": "nonconformity-register",
  "title": "Nonconformity and Corrective Action Register",
  "filenameStem": "Nonconformity_Register",
  "documentType": "register",
  "purpose": "A log of every nonconformity (audit findings, complaints, incidents, supplier issues) and the status of its correction, corrective action and effectiveness check, for trend review.",
  "requiredProfileFields": [
    "legal_name",
    "numbering_convention",
    "main_processes",
    "org_roles"
  ],
  "questions": [
    {
      "id": "sources",
      "text": "Which sources feed the register (internal audits, customer complaints, incidents, supplier issues, inspections)?",
      "kind": "text"
    },
    {
      "id": "classes",
      "text": "How are nonconformities classified?",
      "kind": "choice",
      "options": [
        "Major / minor / observation",
        "Critical / major / minor",
        "Other (describe)"
      ]
    },
    {
      "id": "owner",
      "text": "Who maintains the register (role)?",
      "kind": "text"
    },
    {
      "id": "trends",
      "text": "How often are trends reviewed, and where?",
      "kind": "text"
    }
  ],
  "requiredSections": [
    "Purpose and how to use the register",
    "Register table",
    "Trend review",
    "Link to management review"
  ],
  "optionalSections": [
    "Summary chart by source and by process"
  ],
  "expectedRecords": [
    "The register itself",
    "Linked corrective action forms",
    "Trend review notes or management review minutes"
  ],
  "draftingRules": [
    "Table columns: NC no. | Date | Source | Process or clause | Description | Classification | Correction | Root cause | Corrective action | Owner | Due | Status | Effectiveness verified (date, by).",
    "Leave the table empty apart from one example row clearly marked as an example."
  ],
  "reviewerChecklist": [
    "Columns match the corrective action form",
    "Every source in use feeds the register",
    "Trend review actually happens",
    "Owner recorded"
  ],
  "sources": [
