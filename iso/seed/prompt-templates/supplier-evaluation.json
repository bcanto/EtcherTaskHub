{
  "templateId": "supplier-evaluation",
  "title": "Supplier and Contractor Evaluation",
  "filenameStem": "Supplier_Contractor_Evaluation",
  "documentType": "form",
  "purpose": "A record of how a supplier or contractor was assessed against the organisation's criteria before use and re-evaluated during use, including quality, environmental and work health and safety performance.",
  "requiredProfileFields": [
    "legal_name",
    "business_activities",
    "approval_roles"
  ],
  "questions": [
    {
      "id": "criteria",
      "text": "Which criteria are used to select and evaluate suppliers and contractors (for example quality, delivery, WHS record, licences, insurance)?",
      "kind": "text"
    },
    {
      "id": "rating",
      "text": "How are results rated, and what result is needed to approve a supplier?",
      "kind": "text"
    },
    {
      "id": "monitoring",
      "text": "How often are approved suppliers and contractors re-evaluated, and what triggers an earlier review?",
      "kind": "text"
    },
    {
      "id": "whs",
      "text": "For contractors working on the organisation's jobs, how are work health and safety arrangements agreed and checked?",
      "kind": "text"
    }
  ],
  "requiredSections": [
    "Supplier or contractor details",
    "Criteria and scores",
    "Evidence checked (licences, insurance, certifications)",
    "Work health and safety arrangements (contractors)",
    "Result and approval",
    "Re-evaluation record"
  ],
  "optionalSections": [
    "Approved supplier list format"
  ],
  "expectedRecords": [
    "Completed evaluation forms",
    "The approved supplier and contractor list",
    "Re-evaluation and performance records"
  ],
  "draftingRules": [
    "A one- or two-page form with tick boxes and short fields, plus a scoring table.",
    "Use only the criteria the user confirmed.",
    "Leave space for the evidence sighted (licence numbers, policy expiry dates) — never fill in example numbers."
  ],
  "reviewerChecklist": [
    "Criteria match the organisation's needs",
    "Evidence is actually checked",
    "Approval is recorded",
    "Re-evaluations happen"
  ],
