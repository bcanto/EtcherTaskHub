{
  "templateId": "management-review",
  "title": "Management Review Agenda and Minutes",
  "filenameStem": "Management_Review_Agenda_Minutes",
  "documentType": "record",
  "purpose": "An agenda and minutes template for top management's periodic review of the management system: what is reviewed, what is decided, and who acts.",
  "requiredProfileFields": [
    "legal_name",
    "approval_roles",
    "org_roles",
    "standards_in_scope"
  ],
  "questions": [
    {
      "id": "frequency",
      "text": "How often is the management review held?",
      "kind": "text"
    },
    {
      "id": "attendees",
      "text": "Who attends (roles)?",
      "kind": "text"
    },
    {
      "id": "period",
      "text": "What period does the next review cover?",
      "kind": "text"
    },
    {
      "id": "data",
      "text": "Which performance information is available to bring (objectives, customer feedback, audit results, incidents, environmental data, supplier performance)?",
      "kind": "text"
    }
  ],
  "requiredSections": [
    "Meeting details and attendees",
    "Actions from previous reviews",
    "Changes in external and internal issues",
    "Performance of the management system (objectives, customer and interested-party feedback, process performance, nonconformities and corrective actions, monitoring and measurement results, audit results, external providers, compliance evaluation, WHS consultation and incidents, environmental performance)",
    "Adequacy of resources",
    "Effectiveness of actions on risks and opportunities",
    "Opportunities for improvement",
    "Decisions and actions (owner and due date for each)",
    "Sign-off"
  ],
  "optionalSections": [
    "Attachments list (data packs presented)"
  ],
  "expectedRecords": [
    "Signed minutes",
    "The data presented at the meeting",
    "The action list with owners and due dates, and evidence actions were closed"
  ],
  "draftingRules": [
    "Give each agenda item a \"Discussion\" and a \"Decision / action\" field so the same document works as the minutes.",
    "Never fill in discussion or decisions — leave them for the meeting."
  ],
  "reviewerChecklist": [
    "Every agenda heading has been covered",
    "Decisions have owners and due dates",
    "Attendance matches the stated roles",
    "Minutes are approved and kept"
  ],
  "sources": [
