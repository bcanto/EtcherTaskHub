{
  "templateId": "competency-matrix",
  "title": "Competency Matrix",
  "filenameStem": "Competency_Matrix",
  "documentType": "register",
  "purpose": "Shows, for each role, the competence it needs (education, training, licences, experience), who holds it and until when, so gaps are seen and closed before people do the work.",
  "requiredProfileFields": [
    "org_roles",
    "business_activities",
    "main_processes"
  ],
  "questions": [
    {
      "id": "credentials",
      "text": "Which of these does the work require? Tick only what applies — each ticked item becomes a confirmed requirement in the matrix; add anything else (for example client site tickets) under Other.",
      "kind": "checklist",
      "allowOther": true,
      "items": [
        {
          "id": "electrician",
          "label": "Electrical worker's licence (electrician)",
          "source": 1,
          "note": null
        },
        {
          "id": "contractor",
          "label": "Electrical contractor's licence (held by the business)",
          "source": 1,
          "note": null
        },
        {
          "id": "hrw-licence",
          "label": "High risk work licences for the classes of work done",
          "source": 2,
          "note": "Part 4.5"
        },
        {
          "id": "confined-training",
          "label": "Training for work in confined spaces",
          "source": 2,
          "note": "Part 4.3"
        },
        {
          "id": "asbestos-training",
          "label": "Asbestos training where asbestos may be encountered",
          "source": 2,
          "note": "Chapter 8"
        },
        {
          "id": "mine-induction",
          "label": "Mine site inductions required by the mine operator",
          "source": 3,
          "note": null
        }
      ]
    },
    {
      "id": "roles",
      "text": "Which roles should the matrix cover?",
      "kind": "text"
    },
    {
      "id": "evaluation",
      "text": "How is competence checked (for example licence checks, assessments, supervised work) and how is a gap closed?",
      "kind": "text"
    }
  ],
  "requiredSections": [
    "Roles covered",
    "Competence required per role",
    "Matrix of people against requirements (with expiry dates)",
    "How competence is evaluated and gaps closed",
    "Review record"
  ],
  "optionalSections": [
    "Planned training for the next period"
  ],
  "expectedRecords": [
    "The matrix itself",
    "Copies of licences and certificates (or a register of them) with expiry dates",
    "Records of training and of competence evaluations"
  ],
  "draftingRules": [
    "Rows are people (or roles), columns are requirements; cells show held / expiry date / gap.",
    "Include only requirements that are ticked or confirmed; never invent licences or people.",
    "Licences are listed by their title as published in the instrument ticked."
  ],
  "reviewerChecklist": [
    "Every role has its requirements defined",
    "Every licence is in date",
    "Gaps have a plan and a date",
    "The matrix matches the people actually doing the work"
  ],
