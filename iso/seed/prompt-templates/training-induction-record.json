{
  "templateId": "training-induction-record",
  "title": "Training and Induction Record",
  "filenameStem": "Training_Induction_Record",
  "documentType": "form",
  "purpose": "Records the induction and training each person received — what was covered, when, by whom, and the person's acknowledgement — so competence and awareness can be shown.",
  "requiredProfileFields": [
    "legal_name",
    "org_roles"
  ],
  "questions": [
    {
      "id": "content",
      "text": "What does the induction cover (for example the policy, hazards and controls, emergency procedures, reporting, the person's role in the management system)?",
      "kind": "text"
    },
    {
      "id": "training",
      "text": "Which other training is recorded on this form (for example toolbox training, refresher training)?",
      "kind": "text"
    },
    {
      "id": "signoff",
      "text": "Who delivers and signs off induction and training, and does the person sign to acknowledge it?",
      "kind": "text"
    },
    {
      "id": "refresh",
      "text": "How often is induction or training refreshed?",
      "kind": "text"
    }
  ],
  "requiredSections": [
    "Person and role",
    "Induction topics covered",
    "Training delivered",
    "Trainer and date",
    "Acknowledgement by the person",
    "Refresher due date"
  ],
  "optionalSections": [
    "Assessment of understanding (questions or practical check)"
  ],
  "expectedRecords": [
    "Completed induction and training records",
    "Training attendance registers",
    "Refresher schedule"
  ],
  "draftingRules": [
    "A one-page form with a checklist of the confirmed induction topics and signature lines.",
    "List only topics the user confirmed; leave placeholders otherwise.",
    "Keep the language plain enough for a new starter to sign with understanding."
  ],
  "reviewerChecklist": [
    "Topics match what is actually delivered",
    "Each record is signed and dated",
    "Refreshers are scheduled",
    "Records are kept for everyone doing the work"
  ],
