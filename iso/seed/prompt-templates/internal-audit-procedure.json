{
  "templateId": "internal-audit-procedure",
  "title": "Internal Audit Procedure",
  "filenameStem": "Internal_Audit_Procedure",
  "documentType": "procedure",
  "purpose": "Describes how the organisation plans, conducts, reports and follows up internal audits of its management system.",
  "requiredProfileFields": [
    "legal_name",
    "ims_scope",
    "standards_in_scope",
    "org_roles",
    "approval_roles",
    "numbering_convention",
    "revision_convention"
  ],
  "questions": [
    {
      "id": "competence",
      "text": "What makes someone competent to audit (training, experience)?",
      "kind": "text"
    },
    {
      "id": "impartiality",
      "text": "How does the organisation make sure auditors don't audit their own work (especially if it is small)?",
      "kind": "text"
    },
    {
      "id": "frequency",
      "text": "How is audit frequency decided (importance of processes, changes, previous results)?",
      "kind": "text"
    },
    {
      "id": "grading",
      "text": "How are findings graded (for example major / minor / observation / opportunity for improvement)?",
      "kind": "text"
    },
    {
      "id": "approver",
      "text": "Who approves the audit program and receives the reports (role)?",
      "kind": "text"
    }
  ],
  "requiredSections": [
    "Purpose and scope",
    "Responsibilities",
    "Planning the audit program",
    "Selecting auditors — competence and impartiality",
    "Conducting an audit",
    "Reporting and grading findings",
    "Follow-up and corrective action",
    "Records",
    "Review of this procedure"
  ],
  "optionalSections": [
    "Remote or hybrid audits"
  ],
  "expectedRecords": [
    "Audit program",
    "Audit plans and checklists",
    "Audit reports",
    "Corrective action records arising from audits",
    "Auditor competence records"
  ],
  "draftingRules": [
    "Write as numbered steps a new auditor could follow.",
    "Describe impartiality in a way that works for the organisation's actual size."
  ],
  "reviewerChecklist": [
    "Auditors cannot audit their own work",
    "Findings flow into the corrective action process",
    "Records listed are actually kept",
    "Roles named exist in the organisation"
  ],
