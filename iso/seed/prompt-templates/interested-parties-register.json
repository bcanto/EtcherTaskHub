  "purpose": "Identifies the interested parties relevant to the management system, their relevant needs and expectations, which of those the organisation adopts as requirements or obligations, and how they are met and monitored.",
  "requiredProfileFields": [
    "legal_name",
    "business_activities",
    "operating_locations",
    "interested_parties",
    "legal_obligations",
    "jurisdiction"
  ],
  "questions": [
    {
      "id": "method",
      "text": "How were the interested parties identified (workshop, contract review, regulator list, other)?",
      "kind": "text"
    },
    {
      "id": "climate",
      "text": "Do any interested parties have climate-related requirements (for example client reporting or contract clauses)?",
      "kind": "text"
    },
    {
      "id": "owner",
      "text": "Who owns and maintains the register (role)?",
      "kind": "text"
    },
    {
      "id": "review",
      "text": "How often is the register reviewed?",
      "kind": "text"
    }
  ],
  "requiredSections": [
    "Purpose and method",
    "Register of interested parties",
    "Needs and expectations adopted as requirements or obligations",
    "How each is met and monitored",
    "Review record"
  ],
  "optionalSections": [
    "Communication plan cross-reference"
  ],
  "expectedRecords": [
    "The register itself",
    "Records of communication with key parties (client contracts, regulator correspondence)",
    "Management review minutes that review interested parties"
  ],
  "draftingRules": [
    "Table columns: Interested party | Relevant needs and expectations | Adopted as a requirement or obligation? | How we meet and monitor it | Owner | Review date.",
    "Only list parties supplied as confirmed information or answers; never assume regulators, clients or communities."
  ],
  "reviewerChecklist": [
    "Each party is genuinely relevant",
    "Legal obligations here match the legal and other requirements register",
    "Monitoring methods are real",
    "Review date and owner recorded"
  ],
