{
  "templateId": "risk-opportunity-register",
  "title": "Risk and Opportunity Register",
  "filenameStem": "Risk_Opportunity_Register",
  "documentType": "register",
  "purpose": "Records the risks and opportunities that arise from the organisation's context, interested parties, environmental aspects and WHS hazards, the actions planned for each, and how their effectiveness is evaluated.",
  "requiredProfileFields": [
    "legal_name",
    "business_activities",
    "main_processes",
    "internal_issues",
    "external_issues",
    "whs_hazards",
    "environmental_aspects",
    "approval_roles"
  ],
  "questions": [
    {
      "id": "matrix",
      "text": "Which rating method does the organisation use?",
      "kind": "choice",
      "options": [
        "5 × 5 likelihood × consequence",
        "4 × 4 likelihood × consequence",
        "3 × 3 likelihood × consequence",
        "Other (describe)"
      ]
    },
    {
      "id": "acceptance",
      "text": "Above which rating does a risk need treatment before work continues?",
      "kind": "text"
    },
    {
      "id": "owners",
      "text": "Which roles own risks and approve treatments?",
      "kind": "text"
    },
    {
      "id": "review",
      "text": "How often is the register reviewed, and what triggers an extra review (incident, change, new work)?",
      "kind": "text"
    }
  ],
  "requiredSections": [
    "Method and rating matrix",
    "Register of risks and opportunities",
    "Planned actions and owners",
    "Evaluation of effectiveness",
    "Link to the WHS hazard register and environmental aspects register",
    "Review record"
  ],
  "optionalSections": [
    "Opportunities pursued and their outcomes"
  ],
  "expectedRecords": [
    "The register itself",
    "Records of actions taken and their effectiveness checks",
    "Management review minutes reviewing risks and opportunities"
  ],
  "draftingRules": [
    "Table columns: ID | Source (issue, party, aspect or hazard) | Risk or opportunity | Likelihood | Consequence | Rating | Actions | Owner | Due | Effectiveness check.",
    "Every row must come from confirmed information or an answer; otherwise leave a placeholder row — never invent risks.",
    "For WHS risks, controls follow the hierarchy of control as described in the Safe Work Australia code cited (eliminate first; then substitute, isolate or engineer; then administrative controls; then PPE)."
  ],
  "reviewerChecklist": [
    "Each risk traces to a real source",
    "Ratings follow the stated method",
    "WHS controls follow the hierarchy of control",
    "Every action has an owner and a due date",
    "Effectiveness is actually checked"
  ],
  "sources": [
