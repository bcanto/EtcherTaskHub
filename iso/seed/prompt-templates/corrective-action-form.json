{
  "templateId": "corrective-action-form",
  "title": "Corrective Action Form",
  "filenameStem": "Corrective_Action_Form",
  "documentType": "form",
  "purpose": "Records one nonconformity or incident through to closure: the immediate correction, root-cause analysis, corrective action and a check that it worked.",
  "requiredProfileFields": [
    "legal_name",
    "numbering_convention",
    "org_roles",
    "approval_roles"
  ],
  "questions": [
    {
      "id": "numbering",
      "text": "How are corrective actions numbered (for example CA-2026-001)?",
      "kind": "text"
    },
    {
      "id": "method",
      "text": "Which root-cause method is normally used?",
      "kind": "choice",
      "options": [
        "5 Whys",
        "Fishbone (cause and effect)",
        "Either, depending on the case",
        "Other (describe)"
      ]
    },
    {
      "id": "verifier",
      "text": "Who verifies effectiveness (role), and how long after implementation?",
      "kind": "text"
    }
  ],
  "requiredSections": [
    "Identification (number, date, raised by, source)",
    "Description of the nonconformity or incident",
    "Immediate correction and containment",
    "Root-cause analysis",
    "Corrective action plan (action, owner, due date)",
    "Could this happen elsewhere? (similar risks reviewed)",
    "Effectiveness verification (method, date, result, verified by)",
    "Closure sign-off"
  ],
  "optionalSections": [
    "Updates needed to risks, procedures or training"
  ],
  "expectedRecords": [
    "Completed forms",
    "Evidence for each action",
    "The effectiveness check record"
  ],
  "draftingRules": [
    "Make it a fill-in form: labelled fields and tick boxes, no example content.",
    "Keep correction (fixing this case) separate from corrective action (stopping it recurring)."
  ],
  "reviewerChecklist": [
    "Correction and corrective action are separate",
    "Root cause is a cause, not a restated symptom",
    "Effectiveness is verified by someone other than the action owner",
    "Numbering matches the stated convention"
  ],
  "sources": [
    {
      "title": "Etcher ISO gap analysis workbook V2.0 — evidence examples (column G)",
      "publisher": "Etcher Solutions",
