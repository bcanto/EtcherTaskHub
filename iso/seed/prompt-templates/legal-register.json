{
  "templateId": "legal-register",
  "title": "Legal and Other Requirements Register",
  "filenameStem": "Legal_Other_Requirements_Register",
  "documentType": "register",
  "purpose": "Lists the legal requirements and other requirements (compliance obligations) that apply to the organisation's activities, products and services, what each requires of it, who is responsible, and how and when compliance is evaluated.",
