    {
      "id": "updates",
      "text": "How does the organisation find out about new or changed requirements, and who checks?",
      "kind": "text"
    },
    {
      "id": "evaluation",
      "text": "How, how often, and by whom is compliance with each requirement evaluated?",
      "kind": "text"
    }
  ],
  "requiredSections": [
    "How requirements are identified and kept up to date",
    "Register of legal and other requirements",
    "What each requirement means for the organisation",
    "Responsibilities",
    "Evaluation of compliance (method, frequency, results)",
    "Review record"
  ],
  "optionalSections": [
    "Licences, permits and registrations held, with expiry dates"
  ],
  "expectedRecords": [
    "The register itself",
    "Records of compliance evaluations and their results",
    "Copies or references of licences and permits held"
  ],
  "draftingRules": [
    "Table columns: ID | Requirement (title as published) | Type (law / permit / licence / other) | What it requires of the organisation | Applies to | Responsible | Evaluation method | Frequency | Last evaluated | Result.",
    "List only instruments that are ticked or confirmed in the profile or answers, by their title as published. Never add others, never cite section numbers unless given, and never name a regulator or department unless the user confirmed it — names and responsibilities change.",
    "Where what an instrument requires of the organisation is not confirmed, leave a placeholder."
  ],
  "reviewerChecklist": [
    "Every listed requirement applies and is current",
    "Titles are exactly as published",
    "Each has an owner and an evaluation method",
    "Compliance has actually been evaluated",
    "Licences and permits are in date"
  ],
