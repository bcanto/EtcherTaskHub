{
  "templateId": "internal-audit-program",
  "title": "Internal Audit Program",
  "filenameStem": "Internal_Audit_Program",
  "documentType": "plan",
  "purpose": "The schedule of internal audits over a cycle, covering every process, standard and site, set according to importance, changes and previous results.",
  "requiredProfileFields": [
    "main_processes",
    "operating_locations",
    "standards_in_scope",
    "org_roles"
  ],
  "questions": [
    {
      "id": "cycle",
      "text": "Over what period does the program run?",
      "kind": "choice",
      "options": [
        "12 months",
        "3 years (certification cycle)",
        "Other (describe)"
      ]
    },
    {
      "id": "importance",
      "text": "Which processes are most important or highest risk, and should be audited more often?",
      "kind": "text"
    },
    {
      "id": "auditors",
      "text": "Who is available to audit (names or roles), and what can each not audit for impartiality?",
      "kind": "text"
    },
    {
      "id": "previous",
      "text": "What did previous audits find that should shape this program?",
      "kind": "text"
    }
  ],
  "requiredSections": [
    "Program period and objectives",
    "Coverage matrix (process or area × standards × planned month)",
    "Auditor assignments",
    "How the program is adjusted",
    "Status tracking"
  ],
  "optionalSections": [
    "Supplier or second-party audits"
  ],
  "expectedRecords": [
    "The approved program",
    "Audit reports for each planned audit",
    "Records of program changes and why"
  ],
  "draftingRules": [
    "Lay the coverage out as a table so gaps are visible at a glance.",
    "Use only processes, sites and people supplied as confirmed information or answers."
  ],
  "reviewerChecklist": [
    "Every process and site is covered in the cycle",
    "Higher-risk processes are audited more often",
    "No auditor is assigned to their own work",
    "Approved by the stated role"
  ],
