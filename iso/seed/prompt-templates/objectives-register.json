{
  "templateId": "objectives-register",
  "title": "Objectives and Targets Register",
  "filenameStem": "Objectives_Targets_Register",
  "documentType": "register",
  "purpose": "Records the organisation's quality, environmental and health and safety objectives, consistent with its policy, with targets, actions, resources, owners, timeframes and how results are measured and reviewed.",
  "requiredProfileFields": [
    "legal_name",
    "standards_in_scope",
    "ims_scope",
    "approval_roles"
  ],
  "questions": [
    {
      "id": "objectives",
      "text": "What objectives has the organisation set (for each area it manages)?",
      "kind": "text"
    },
    {
      "id": "measures",
      "text": "How is each objective measured, and what is the target?",
      "kind": "text"
    },
    {
      "id": "plans",
      "text": "What will be done, with what resources, by whom and by when?",
      "kind": "text"
    },
    {
      "id": "review",
      "text": "How often is progress reviewed and reported (for example at management review)?",
      "kind": "text"
    }
  ],
  "requiredSections": [
    "Link to the policy",
    "Register of objectives and targets",
    "Action plans (what, resources, who, when)",
    "Measurement and progress",
    "Review record"
  ],
  "optionalSections": [
    "Objectives carried over from the previous period, with results"
  ],
  "expectedRecords": [
    "The register itself",
    "Progress reports or dashboards",
    "Management review minutes reviewing objectives"
  ],
  "draftingRules": [
    "Table columns: ID | Objective | Area (quality / environment / WHS) | Target | Measure | Actions | Resources | Owner | Due | Status.",
    "Use only objectives the user gave; do not set targets the organisation did not choose.",
    "Objectives must be measurable where practicable and consistent with the policy."
  ],
  "reviewerChecklist": [
    "Each objective is consistent with the policy",
    "Each is measurable, with a target and a due date",
    "Actions have owners and resources",
    "Progress is actually reviewed"
  ],
  "sources": [
