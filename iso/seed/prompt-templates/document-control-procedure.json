    "Document register template",
    "Retention schedule"
  ],
  "expectedRecords": [
    "The document register (master list)",
    "Approval records for each document",
    "Retention schedule"
  ],
  "draftingRules": [
    "Use the organisation's confirmed numbering and revision conventions; leave placeholders where they are not confirmed.",
    "Describe the system the organisation actually uses; do not invent software or approval steps.",
    "Write in steps a new staff member could follow."
  ],
  "reviewerChecklist": [
    "Numbering and revision rules match practice",
    "Every document type has an approver",
    "Obsolete documents are prevented from unintended use",
    "Retention periods are stated"
  ],
