{
  "templateId": "document-control-procedure",
  "title": "Document Control Procedure",
  "filenameStem": "Document_Control_Procedure",
  "documentType": "procedure",
  "purpose": "Describes how the organisation creates, identifies, reviews, approves, issues, changes, stores, protects, retains and disposes of its documented information, including documents from outside sources.",
  "requiredProfileFields": [
    "legal_name",
    "numbering_convention",
    "revision_convention",
    "review_frequency",
    "approval_roles"
  ],
  "questions": [
    {
      "id": "system",
      "text": "Where are controlled documents kept (for example SharePoint), and who can edit or only read them?",
      "kind": "text"
    },
    {
      "id": "approval",
      "text": "Who reviews and approves each type of document before issue?",
      "kind": "text"
    },
    {
      "id": "retention",
      "text": "How long are records kept, and how are they protected and disposed of?",
      "kind": "text"
    },
    {
      "id": "external",
      "text": "Which documents of external origin are controlled (for example standards, client specifications) and how?",
      "kind": "text"
    }
  ],
