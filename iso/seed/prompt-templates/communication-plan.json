{
  "templateId": "communication-plan",
  "title": "Communication Plan",
  "filenameStem": "Communication_Plan",
  "documentType": "plan",
  "purpose": "Sets out what the organisation communicates about its management system — internally and externally — when, with whom, how and by whom, including how workers are consulted and can take part.",
  "requiredProfileFields": [
    "legal_name",
    "org_roles",
    "interested_parties"
  ],
  "questions": [
    {
      "id": "internal",
      "text": "What is communicated internally (for example toolbox talks, notices, meetings), how often and by whom?",
      "kind": "text"
    },
    {
      "id": "external",
      "text": "What is communicated externally (customers, regulators, the community, contractors), when and by whom?",
      "kind": "text"
    },
    {
      "id": "consultation",
      "text": "How are workers consulted and how do they take part (for example health and safety representatives, committees, toolbox meetings)?",
      "kind": "text"
    },
    {
      "id": "records",
      "text": "How are communications recorded?",
      "kind": "text"
    }
  ],
  "requiredSections": [
    "Purpose and scope",
    "Internal communication (what, when, who, how)",
    "External communication (what, when, who, how)",
    "Worker consultation and participation",
    "Records of communication",
    "Review record"
  ],
  "optionalSections": [
    "Communication during emergencies (cross-reference to the emergency plan)"
  ],
  "expectedRecords": [
    "Toolbox and meeting records",
    "Records of consultation with workers",
    "Records of significant external communications"
  ],
  "draftingRules": [
    "Lay the plan out as a table: Topic | Audience | Method | Frequency | Responsible | Record kept.",
    "Use only the methods and audiences the user confirmed.",
    "Do not name a regulator unless the user confirmed it."
  ],
  "reviewerChecklist": [
    "Internal and external communication are both covered",
    "Worker consultation is real and recorded",
    "Each line has an owner",
    "Records are actually kept"
  ],
